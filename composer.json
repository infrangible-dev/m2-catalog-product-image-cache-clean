{
    "name": "infrangible/m2-catalog-product-image-cache-clean",
    "description": "Adds a \"Clean Image Cache\" button to the product edit page that removes the resized cached images of this product, so updated images appear right away.",
    "type": "magento2-module",
    "version": "1.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Catalog",
        "Performance",
        "Admin tools",
        "clean product image cache",
        "refresh resized product images",
        "image cache button"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-product-image-cache-clean",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductImageCacheClean\\": "src"
        }
    }
}
